import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "ai_side_panel"

  static_files = [ "ai_side_panel.html" ]

  ts_files = [ "ai_side_panel.ts" ]

  ts_deps = [ "//ui/webui/resources/js:build_ts" ]

  webui_context_type = "trusted"
}
